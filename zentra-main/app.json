{
  "expo": {
    "name": "Zentra AI",
    "slug": "zentra-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "myapp",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zentraai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zentra AI to use your camera for live form correction."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow Zentra AI to use your camera for live form correction.",
          "enableFrameProcessors": true
        }
      ],
      "./plugins/withAndroidCleartext",
      "./plugins/withMediaPipePoseModel",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zentra AI to access your photos so you can upload a profile picture."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7015349-c0bb-4663-bd2a-3692daef8c8a"
      }
    }
  }
}
